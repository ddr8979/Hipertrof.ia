# =============================================================================
# Plantilla de variables de entorno — Hipertrof.ia (web)
# Copiar a `.env.local` y completar. NUNCA commitear `.env.local`.
#
#   cp .env.example .env.local
#
# Reglas:
#  - `NEXT_PUBLIC_*` se expone al navegador (no poner secretos ahí).
#  - Las claves de service_role / client secrets SOLO viven en el servidor
#    (este archivo es para dev; en producción se cargan desde Vercel Env).
# =============================================================================

# --- Supabase (obligatorio) ---------------------------------------------------
# URL del proyecto. En local usá el proyecto de DEV/STAGING, nunca producción.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon/publishable key: segura para el navegador (respeta RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu-anon-key

# Service role: BYPASEA RLS. Solo server-side. NUNCA en el cliente ni en git.
# En local: usá la del proyecto de DEV. En producción: Vercel Env.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_tu-service-role-key

# --- App ----------------------------------------------------------------------
# Origen público de la app (redirecciones OAuth, links de invitación, QR).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Proveedores OAuth habilitados, separados por coma (ej. "google" o "google,apple").
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Google OAuth (opcional en local; en prod va en Vercel) -------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Spotify (panel de playlists, OAuth PKCE) ---------------------------------
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Web Push (VAPID) ---------------------------------------------------------
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@hypertrofia.app

# Secreto compartido para autorizar /api/push/send (server-side).
PUSH_HOOK_SECRET=

# --- YouTube (endpoint opcional de búsqueda) ----------------------------------
# YOUTUBE_API_KEY=
